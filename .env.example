# Copy to .env and fill in locally. Never commit .env.

APP_NAME=project
APP_ENV=development
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- PostgreSQL ---
# postgres://USER:PASSWORD@HOST:PORT/NAME   (host 'db' inside docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
DB_CONN_MAX_AGE=60

# --- Redis (cache, sessions) ---
REDIS_URL=redis://localhost:6379/1

# --- Celery: RabbitMQ broker, result backend ---
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# 'django-db' stores results via django-celery-results; or redis://localhost:6379/2
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# --- API clients ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production-only toggles (ignored when DEBUG=true) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- AI (provider-neutral; e.g. openai | anthropic | google | ollama | local | none) ---
AI_PROVIDER=
AI_MODEL=

GIT_PROVIDER=
PROJECT_MANAGEMENT_PROVIDER=
