# Copy to .env and fill in locally. Never commit .env.

APP_ENV=development
APP_NAME=project

# Django
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=

# Database: SQLite. Leave blank to use ./db.sqlite3, or set an explicit path:
#   DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
DATABASE_URL=

# AI (provider-neutral; e.g. openai | anthropic | google | ollama | local | none)
AI_PROVIDER=
AI_MODEL=

# Source control host (e.g. github | gitlab)
GIT_PROVIDER=

# Project management system (e.g. github-projects | gitlab | jira | linear)
PROJECT_MANAGEMENT_PROVIDER=

# Observability
LOG_LEVEL=INFO
